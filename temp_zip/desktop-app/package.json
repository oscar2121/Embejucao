{
  "name": "desktop-app",
  "private": true,
  "version": "0.0.0",
  "main": "main.js",
  "scripts": {
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder --win -c.extraMetadata.main=main.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.embejucao.pos2",
    "productName": "Embejucao POS v2",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      { "from": "extraResources/ngrok.exe", "to": "ngrok.exe" },
      { "from": "../printerService.js", "to": "printerService.js" },
      {
        "from": "../server.js",
        "to": "server.js"
      },
      {
        "from": "../embejucao.db",
        "to": "embejucao.db"
      },
      {
        "from": "../uploads",
        "to": "uploads"
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!react-native{,/**/*}",
          "!expo{,/**/*}"
        ]
      },
      {
        "from": "../.env",
        "to": ".env"
      }
    ]
  }
}
